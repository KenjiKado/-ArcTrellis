<Window x:Class="ArcTrellis.App.Views.EditBookWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Edit book" Width="460" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="20">
  <TextBlock Text="Title" Margin="0,0,0,4"/>
  <TextBox x:Name="TitleInput"/>
  <TextBlock Text="Subtitle" Margin="0,12,0,4"/>
  <TextBox x:Name="SubtitleInput"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="Save" IsDefault="True" Click="Save_Click"/>
   <Button Content="Cancel" IsCancel="True"/>
  </StackPanel>
 </StackPanel>
</Window>
