<Window x:Class="ArcTrellis.App.Views.EditPlotlineWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Edit plotline" Width="500" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="20">
  <TextBlock Text="Title" Margin="0,0,0,4"/>
  <TextBox x:Name="TitleInput"/>
  <TextBlock Text="Description" Margin="0,12,0,4"/>
  <TextBox x:Name="DescriptionInput" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
  <TextBlock Text="Color" Margin="0,12,0,4"/>
  <StackPanel Orientation="Horizontal">
   <Border x:Name="ColorPreview" Width="72" Height="30" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
   <Button Content="Choose color" Click="ChooseColor_Click"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="Save" IsDefault="True" Click="Save_Click"/>
   <Button Content="Cancel" IsCancel="True"/>
  </StackPanel>
 </StackPanel>
</Window>
