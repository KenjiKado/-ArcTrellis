<Window x:Class="ArcTrellis.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project — ArcTrellis" Width="780" Height="570" MinWidth="650" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="20" Background="{DynamicResource PageBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Start a story project" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Choose a working example or begin with a blank timeline. Everything can be edited later." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,16"/></StackPanel>
    <ListBox x:Name="TemplateList" Grid.Row="1" SelectedIndex="0" BorderThickness="0" Background="Transparent">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="220" Height="135"><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentBrush}" Margin="0,4"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" MaxHeight="55"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="2" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancel" IsCancel="True"/><Button Content="Create project" Click="Create_Click" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="White"/></StackPanel><TextBlock Text="Includes five editable starter templates" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
  </Grid>
</Window>
