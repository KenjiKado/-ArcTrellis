<Application x:Class="ArcTrellis.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B7CFA"/>
    <SolidColorBrush x:Key="PageBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="PanelBrush" Color="White"/>
    <SolidColorBrush x:Key="TextBrush" Color="#202638"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DEEA"/>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,3"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="6"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="14,8"/>
    </Style>
  </Application.Resources>
</Application>
