<Window x:Class="ArcTrellis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcTrellis.App"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="ArcTrellis" Height="860" Width="1440" MinHeight="650" MinWidth="1000"
        Closing="Window_Closing" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <CollectionViewSource x:Key="ChapterListView" Source="{Binding SelectedBook.Chapters}" IsLiveSortingRequested="True" Filter="ChapterList_Filter">
      <CollectionViewSource.SortDescriptions><scm:SortDescription PropertyName="Order" Direction="Ascending"/></CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <local:ScenePlotlineConverter x:Key="ScenePlotlineConverter"/>
    <local:StatusTextConverter x:Key="StatusTextConverter"/>
    <local:NonNegativeIntegerConverter x:Key="NonNegativeIntegerConverter"/>
    <local:ScenePlotlineColorConverter x:Key="ScenePlotlineColorConverter"/>
    <local:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
    <DataTemplate x:Key="EntityEditorTemplate">
      <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="Story bible entry" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Name" Margin="0,10,0,0"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="18"/><TextBlock Text="Category"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Tags"/><local:TagInput Tags="{Binding Tags}" Project="{Binding DataContext.Project, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="One-line summary"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Details"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"/><TextBlock Text="Image file path (optional)"/><TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Custom sheet fields" FontWeight="SemiBold" Margin="0,10,0,0"/><DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False" CanUserAddRows="True" MinHeight="160"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></Border>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenuItem" Header="File" Style="{StaticResource TopMenuItemStyle}">
        <MenuItem Header="New from Template…" InputGestureText="Ctrl+N" Click="New_Click"/>
        <MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="Open_Click"/>
        <Separator/>
        <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="Save As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
        <MenuItem Header="Save as reusable Template…" Click="SaveTemplate_Click"/>
        <Separator/>
        <MenuItem Header="Print Timeline…" Click="Print_Click"/>
        <MenuItem Header="Exit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="Edit" Style="{StaticResource TopMenuItemStyle}">
        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
        <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
        <Separator/>
        <MenuItem Header="Add Chapter" InputGestureText="Ctrl+Shift+C" Click="AddChapter_Click"/>
        <MenuItem Header="Add Plotline" Click="AddPlotline_Click"/>
        <MenuItem Header="Add Scene" InputGestureText="Ctrl+Shift+S" Click="AddScene_Click"/>
      </MenuItem>
      <MenuItem Header="View" Style="{StaticResource TopMenuItemStyle}">
        <MenuItem x:Name="LightThemeItem" Header="Light theme" IsCheckable="True" Click="LightTheme_Click"/>
        <MenuItem x:Name="DarkThemeItem" Header="Dark theme" IsCheckable="True" Click="DarkTheme_Click"/>
      </MenuItem>
      <MenuItem x:Name="LanguageMenuItem" Header="Language" Style="{StaticResource TopMenuItemStyle}">
        <MenuItem x:Name="EnglishLanguageItem" Header="English" IsCheckable="True" Click="EnglishLanguage_Click"/>
        <MenuItem x:Name="RussianLanguageItem" Header="Russian" IsCheckable="True" Click="RussianLanguage_Click"/>
      </MenuItem>
      <MenuItem Header="Help" Style="{StaticResource TopMenuItemStyle}">
        <MenuItem Header="User Guide" Click="Guide_Click"/>
        <MenuItem Header="About ArcTrellis" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><StackPanel Orientation="Horizontal"><TextBlock Text="Last changed:"/><TextBlock Text="{Binding Project.ModifiedUtc, StringFormat='{}{0:g}'}" Margin="4,0,0,0"/></StackPanel></StatusBarItem>
      <Separator/>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="Local project • autosave enabled"/></StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="＋ Scene" Click="AddScene_Click"/>
            <Button Content="Save" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="White"/>
          </StackPanel>
          <TextBlock Text="{Binding Project.Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="Story planning studio" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </DockPanel>
      </Border>

      <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="8">
        <TabItem Header="Dashboard">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Series overview" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Title" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox Text="{Binding Project.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18"/>
                    <TextBlock Text="Author" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Project.Author, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Genre" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Project.Genre, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Premise / series description" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Project.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Books in this series" FontSize="18" FontWeight="SemiBold"/>
                    <ListBox MouseDoubleClick="DashboardBook_MouseDoubleClick" ItemsSource="{Binding Project.Books}" SelectedValuePath="Id" SelectedValue="{Binding SelectedBookId}" Margin="0,8,0,0" Height="180">
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Cursor" Value="Hand"/></Style></ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Order, StringFormat='#{0}'}" Foreground="{DynamicResource MutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal"><Button Content="Add book" Click="AddBook_Click"/><Button Content="Edit book" Click="EditBook_Click"/><Button Content="Delete book" Click="DeleteBook_Click"/></StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Writing progress" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedBook.Title}" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Current words" Margin="0,10,0,0"/><TextBox Tag="Numeric" Text="{Binding SelectedBook.CurrentWordCount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NonNegativeIntegerConverter}}"/><TextBlock Text="Book goal" Margin="0,8,0,0"/><TextBox Tag="Numeric" Text="{Binding SelectedBook.WordCountGoal, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NonNegativeIntegerConverter}}"/><ProgressBar x:Name="ProgressBar" Height="16" Margin="0,12,0,4"/><TextBlock x:Name="ProgressText" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="At a glance" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StatsText" Margin="0,10,0,0" FontSize="15" LineHeight="25"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local-first" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Your project stays in the file you choose. ArcTrellis creates rotating local backups and an autosave recovery copy. No account or network connection is used." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Timeline">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <WrapPanel><TextBlock Text="Book:" VerticalAlignment="Center"/><ComboBox x:Name="TimelineBookCombo" ItemsSource="{Binding Project.Books}" SelectedValuePath="Id" SelectedValue="{Binding SelectedBookId}" DisplayMemberPath="Title" Width="190" Margin="8,0"/><Button Content="＋ Plotline" Click="AddPlotline_Click"/><Button Content="＋ Chapter" Click="AddChapter_Click"/><Button Content="Zoom −" Click="ZoomOut_Click"/><Button Content="Zoom +" Click="ZoomIn_Click"/></WrapPanel>
            </Border>
            <ScrollViewer PreviewMouseWheel="Timeline_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource PageBrush}"><Grid x:Name="TimelineGrid" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"/></ScrollViewer>
          </DockPanel>
        </TabItem>

        <TabItem Header="Chapters">
          <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <ComboBox ItemsSource="{Binding Project.Books}" SelectedValuePath="Id" SelectedValue="{Binding SelectedBookId}" DisplayMemberPath="Title"/>
                <StackPanel Orientation="Horizontal"><Button Content="＋ Chapter" Click="AddChapter_Click"/><Button Content="↑" ToolTip="Move chapter up" Click="ChapterUp_Click"/><Button Content="↓" ToolTip="Move chapter down" Click="ChapterDown_Click"/><Button Content="Delete" Click="DeleteChapter_Click"/><Button x:Name="ChapterFilterButton" ToolTip="Filter chapters" AutomationProperties.Name="Filter chapters" Click="ChapterFilter_Click" Width="34" Padding="7,5"><Path Data="M 1,1 L 15,1 L 9.5,7 L 9.5,13 L 6.5,15 L 6.5,7 Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/></Button></StackPanel>
              </StackPanel>
              <ListBox x:Name="ChapterList" ItemsSource="{Binding Source={StaticResource ChapterListView}}" IsSynchronizedWithCurrentItem="False" SelectedValuePath="Id" SelectedValue="{Binding SelectedChapterId}" DisplayMemberPath="Title"/>
            </DockPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
              <StackPanel DataContext="{Binding SelectedChapter}">
                <TextBlock Text="Chapter details" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Title" Margin="0,10,0,3"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="Section / act:"/><TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Status"/><ComboBox ItemsSource="{Binding DataContext.SceneStatuses, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Status}"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Word count"/><TextBox Tag="Numeric" Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NonNegativeIntegerConverter}}"/></StackPanel>
                </Grid>
                <TextBlock Text="Tags" Margin="0,8,0,3"/><local:TagInput Tags="{Binding Tags}" Project="{Binding DataContext.Project, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="Description" Margin="0,8,0,3"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
              <TextBlock Text="Scenes" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4"/>
              <StackPanel Orientation="Horizontal"><Button Content="＋ Scene" Click="AddChapterScene_Click"/><Button Content="Delete" Click="DeleteChapterScene_Click"/></StackPanel>
              <DataGrid RowHeight="44" FontSize="14" CanUserSortColumns="False" MinColumnWidth="120" x:Name="ChapterScenesTable" ItemsSource="{Binding ChapterScenes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="ChapterScene_MouseDoubleClick">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3,0,0,1"/></Trigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent" Padding="10,6"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
                  </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource StatusTextConverter}}" Width="170"/>
                  <DataGridTemplateColumn Header="Plotline" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                      <TextBlock.DataContext><MultiBinding Converter="{StaticResource ScenePlotlineConverter}"><Binding Path="Item.PlotlineId" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/><Binding Path="DataContext.Project.Plotlines" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.DataContext>
                    </TextBlock>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel></ScrollViewer></Border>
          </Grid>
        </TabItem>

        <TabItem Header="Scenes">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="Scenes" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,8"/>
                  <ComboBox ItemsSource="{Binding Project.Books}" SelectedValuePath="Id" SelectedValue="{Binding SelectedBookId}" DisplayMemberPath="Title"/>
                  <Grid Margin="-3,3,-3,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="＋ Scene" Click="AddScene_Click"/><Button Grid.Column="1" Content="Delete" Click="DeleteScene_Click"/></Grid>
                </StackPanel>
                <ListBox x:Name="SceneList" ItemsSource="{Binding BookScenes}" IsSynchronizedWithCurrentItem="False" SelectedValuePath="Id" SelectedValue="{Binding SelectedSceneId}" BorderThickness="0" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="5,0,0,0" Padding="8,5,5,5" Margin="1" Background="Transparent">
                        <Border.BorderBrush>
                          <MultiBinding Converter="{StaticResource ScenePlotlineColorConverter}">
                            <Binding Path="PlotlineId"/>
                            <Binding Path="DataContext.Project.Plotlines" RelativeSource="{RelativeSource AncestorType=Window}"/>
                          </MultiBinding>
                        </Border.BorderBrush>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border x:Name="SceneEditor" Grid.Column="2" Style="{StaticResource Card}" Margin="0" IsEnabled="{Binding SelectedScene, Converter={StaticResource NullToBooleanConverter}}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel DataContext="{Binding SelectedScene}" Margin="2">
                  <TextBlock Text="Scene card" FontSize="22" FontWeight="SemiBold"/>
                  <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,12"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Status" Foreground="{DynamicResource MutedBrush}"/><ComboBox ItemsSource="{Binding DataContext.SceneStatuses, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Plotline" Foreground="{DynamicResource MutedBrush}"/><ComboBox Tag="ScenePlotline" ItemsSource="{Binding DataContext.BookPlotlines, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PlotlineId, UpdateSourceTrigger=Explicit}" DropDownClosed="ScenePlacement_DropDownClosed"/></StackPanel>
                    <StackPanel Grid.Row="1"><TextBlock Text="Chapter" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/><ComboBox Tag="SceneChapter" ItemsSource="{Binding DataContext.SelectedBook.Chapters, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding ChapterId, UpdateSourceTrigger=Explicit}" DropDownClosed="ScenePlacement_DropDownClosed"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Word count" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/><TextBox Tag="Numeric" Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NonNegativeIntegerConverter}}"/></StackPanel>
                  </Grid>
                  <TextBlock Text="Characters" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
                  <local:CharacterInput Project="{Binding DataContext.Project, RelativeSource={RelativeSource AncestorType=Window}}" CharacterIds="{Binding CharacterIds}"/>
                  <TextBlock Text="Tags" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
                  <local:TagInput Tags="{Binding Tags}" Project="{Binding DataContext.Project, RelativeSource={RelativeSource AncestorType=Window}}"/>
                  <TextBlock Text="Summary" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110" VerticalContentAlignment="Top"/>
                  <TextBlock Text="Scene notes / draft" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Height="220" VerticalContentAlignment="Top"/>
                  <TextBlock Text="Editing notes" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBox Text="{Binding EditingNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110" VerticalContentAlignment="Top"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Characters"><Grid x:Name="CharactersHost" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Character" Click="AddCharacter_Click"/><Button Content="Delete" Click="DeleteCharacter_Click"/></StackPanel><ListBox ItemsSource="{Binding Project.Characters}" IsSynchronizedWithCurrentItem="False" SelectedValuePath="Id" SelectedValue="{Binding SelectedCharacterId}" DisplayMemberPath="Name"/></DockPanel></Border><ContentControl Grid.Column="1" Content="{Binding SelectedCharacter}" ContentTemplate="{StaticResource EntityEditorTemplate}"/></Grid></TabItem>
        <TabItem Header="Places"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Place" Click="AddPlace_Click"/><Button Content="Delete" Click="DeletePlace_Click"/></StackPanel><ListBox ItemsSource="{Binding Project.Places}" IsSynchronizedWithCurrentItem="False" SelectedValuePath="Id" SelectedValue="{Binding SelectedPlaceId}" DisplayMemberPath="Name"/></DockPanel></Border><ContentControl Grid.Column="1" Content="{Binding SelectedPlace}" ContentTemplate="{StaticResource EntityEditorTemplate}"/></Grid></TabItem>
        <TabItem Header="Notes"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Note" Click="AddNote_Click"/><Button Content="Delete" Click="DeleteNote_Click"/></StackPanel><ListBox ItemsSource="{Binding Project.Notes}" IsSynchronizedWithCurrentItem="False" SelectedValuePath="Id" SelectedValue="{Binding SelectedNoteId}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><ContentControl Grid.Column="1" Content="{Binding SelectedNote}" ContentTemplate="{StaticResource EntityEditorTemplate}"/></Grid></TabItem>

        <TabItem Header="Relationships">
          <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Relationship" Click="AddRelationship_Click"/><Button Content="Delete" Click="DeleteRelationship_Click"/></StackPanel><ListBox x:Name="RelationshipList" ItemsSource="{Binding Project.Relationships}" IsSynchronizedWithCurrentItem="False" SelectedValuePath="Id" SelectedValue="{Binding SelectedRelationshipId}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Type}" Margin="4"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel DataContext="{Binding SelectedRelationship}"><TextBlock Text="Character &amp; world connections" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="From" Margin="0,12,0,0"/><ComboBox x:Name="RelationFrom" SelectedValue="{Binding FromEntityId}" SelectedValuePath="Id" DisplayMemberPath="Name"/><TextBlock Text="Relationship"/><TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="To"/><ComboBox x:Name="RelationTo" SelectedValue="{Binding ToEntityId}" SelectedValuePath="Id" DisplayMemberPath="Name"/><TextBlock Text="Description"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="180" TextWrapping="Wrap"/></StackPanel></Border></Grid>
        </TabItem>

        <TabItem Header="Search">
          <Border Style="{StaticResource Card}" Margin="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Search the entire series bible" FontSize="20" FontWeight="SemiBold"/><DockPanel Margin="0,10,0,10"><Button DockPanel.Dock="Right" Content="Search" Click="Search_Click" IsDefault="True"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/></DockPanel></StackPanel><ListView ItemsSource="{Binding SearchResults}" MouseDoubleClick="SearchResult_DoubleClick"><ListView.View><GridView><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Kind}" Width="110"/><GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="240"/><GridViewColumn Header="Context" DisplayMemberBinding="{Binding Context}" Width="750"/></GridView></ListView.View></ListView></DockPanel></Border>
        </TabItem>
        <TabItem Header="Series View">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Project.Books}" Margin="12">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="300" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBlock Text="Story spine" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Chapters}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,7"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Section}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>

</Window>






