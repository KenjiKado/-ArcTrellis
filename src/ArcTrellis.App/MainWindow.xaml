<Window x:Class="ArcTrellis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArcTrellis" Height="860" Width="1440" MinHeight="650" MinWidth="1000"
        Closing="Window_Closing" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <DataTemplate x:Key="EntityEditorTemplate">
      <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Story bible entry" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Name" Margin="0,10,0,0"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="18"/><TextBlock Text="Category"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Tags (comma separated)"/><TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="One-line summary"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Details"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"/><TextBlock Text="Image file path (optional)"/><TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Custom sheet fields" FontWeight="SemiBold" Margin="0,10,0,0"/><DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False" CanUserAddRows="True" MinHeight="160"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></Border>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New from Template…" InputGestureText="Ctrl+N" Click="New_Click"/>
        <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click"/>
        <Separator/>
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
        <MenuItem Header="Save as reusable _Template…" Click="SaveTemplate_Click"/>
        <Separator/>
        <MenuItem Header="Import _Markdown…" Click="ImportMarkdown_Click"/>
        <MenuItem Header="_Export">
          <MenuItem Header="Microsoft Word (.docx)…" Click="ExportDocx_Click"/>
          <MenuItem Header="Markdown (.md)…" Click="ExportMarkdown_Click"/>
          <MenuItem Header="Timeline CSV (.csv)…" Click="ExportCsv_Click"/>
          <MenuItem Header="Scrivener project folder…" Click="ExportScrivener_Click"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Print Timeline…" Click="Print_Click"/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
        <Separator/>
        <MenuItem Header="Add _Chapter" InputGestureText="Ctrl+Shift+C" Click="AddChapter_Click"/>
        <MenuItem Header="Add _Plotline" Click="AddPlotline_Click"/>
        <MenuItem Header="Add _Scene" InputGestureText="Ctrl+Shift+S" Click="AddScene_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Light theme" Click="LightTheme_Click"/>
        <MenuItem Header="Dark theme" Click="DarkTheme_Click"/>
        <Separator/>
        <MenuItem Header="Refresh timeline" InputGestureText="F5" Click="Refresh_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="User Guide" Click="Guide_Click"/>
        <MenuItem Header="About ArcTrellis" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock Text="{Binding Project.ModifiedUtc, StringFormat='Last changed: {0:g}'}"/></StatusBarItem>
      <Separator/>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="Local project • autosave enabled"/></StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="＋ Scene" Click="AddScene_Click"/>
            <Button Content="Save" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="White"/>
          </StackPanel>
          <TextBlock Text="{Binding Project.Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="  Story planning studio" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="8">
        <TabItem Header="Dashboard">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Series overview" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Title" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox Text="{Binding Project.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18"/>
                    <TextBlock Text="Author" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Project.Author, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Genre" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Project.Genre, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Premise / series description" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Project.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Books in this series" FontSize="18" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding Project.Books}" SelectedItem="{Binding SelectedBook}" Margin="0,8,0,0" Height="180">
                      <ListBox.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Order, StringFormat='#{0}'}" Foreground="{DynamicResource MutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal"><Button Content="Add book" Click="AddBook_Click"/><Button Content="Delete book" Click="DeleteBook_Click"/></StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Writing progress" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Current words" Margin="0,10,0,0"/><TextBox Text="{Binding Project.CurrentWordCount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Series goal" Margin="0,8,0,0"/><TextBox Text="{Binding Project.WordCountGoal, UpdateSourceTrigger=PropertyChanged}"/><ProgressBar x:Name="ProgressBar" Height="16" Margin="0,12,0,4"/><TextBlock x:Name="ProgressText" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="At a glance" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StatsText" Margin="0,10,0,0" FontSize="15" LineHeight="25"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local-first" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Your project stays in the file you choose. ArcTrellis creates rotating local backups and an autosave recovery copy. No account or network connection is used." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Timeline">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <WrapPanel><TextBlock Text="Book:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Project.Books}" SelectedItem="{Binding SelectedBook}" DisplayMemberPath="Title" Width="190" Margin="8,0"/><TextBlock Text="Plotline:" VerticalAlignment="Center" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding Project.Plotlines}" SelectedItem="{Binding SelectedPlotline}" DisplayMemberPath="Name" Width="150" Margin="8,0"/><TextBox Text="{Binding SelectedPlotline.Name, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Rename selected plotline"/><TextBox Text="{Binding SelectedPlotline.Color, UpdateSourceTrigger=PropertyChanged}" Width="80" ToolTip="Color in #RRGGBB format"/><Button Content="＋ Plotline" Click="AddPlotline_Click"/><Button Content="Delete plotline" Click="DeletePlotline_Click"/><Button Content="＋ Chapter" Click="AddChapter_Click"/><Button Content="Zoom −" Click="ZoomOut_Click"/><Button Content="Zoom +" Click="ZoomIn_Click"/></WrapPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource PageBrush}"><Grid x:Name="TimelineGrid" Margin="10"/></ScrollViewer>
          </DockPanel>
        </TabItem>

        <TabItem Header="Outline">
          <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><ComboBox ItemsSource="{Binding Project.Books}" SelectedItem="{Binding SelectedBook}" DisplayMemberPath="Title"/><StackPanel Orientation="Horizontal"><Button Content="＋ Chapter" Click="AddChapter_Click"/><Button Content="↑" Click="ChapterUp_Click"/><Button Content="↓" Click="ChapterDown_Click"/><Button Content="Delete" Click="DeleteChapter_Click"/></StackPanel></StackPanel><ListBox ItemsSource="{Binding SelectedBook.Chapters}" SelectedItem="{Binding SelectedChapter}" DisplayMemberPath="Title"/></DockPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><Grid DataContext="{Binding SelectedChapter}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Chapter / beat details" FontSize="20" FontWeight="SemiBold"/><TextBox Grid.Row="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,12,0,3"/><StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="Section / act:" VerticalAlignment="Center"/><TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="8,3"/><TextBlock Text="Words:" VerticalAlignment="Center"/><TextBox Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="8,3"/></StackPanel><TextBox Grid.Row="3" Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Grid></Border>
          </Grid>
        </TabItem>

        <TabItem Header="Scenes">
          <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><ComboBox ItemsSource="{Binding Project.Books}" SelectedItem="{Binding SelectedBook}" DisplayMemberPath="Title"/><StackPanel Orientation="Horizontal"><Button Content="＋ Scene" Click="AddScene_Click"/><Button Content="Delete" Click="DeleteScene_Click"/></StackPanel></StackPanel><ListBox ItemsSource="{Binding BookScenes}" SelectedItem="{Binding SelectedScene}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid DataContext="{Binding SelectedScene}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="220"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="Scene card" FontSize="20" FontWeight="SemiBold"/><TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,10,0,3"/><StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Status"/><ComboBox ItemsSource="{Binding DataContext.SceneStatuses, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Status}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="Point of view"/><TextBox Text="{Binding PointOfView, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Setting"/><TextBox Text="{Binding Setting, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="1"><TextBlock Text="Word count"/><TextBox Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="Tags (comma separated)"/><TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}"/></StackPanel><StackPanel Grid.Row="5" Grid.ColumnSpan="2"><TextBlock Text="Summary"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel><StackPanel Grid.Row="6" Grid.ColumnSpan="2"><TextBlock Text="Scene notes / draft"/><TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"/></StackPanel><StackPanel Grid.Row="7" Grid.ColumnSpan="2"><TextBlock Text="Editing notes"/><TextBox Text="{Binding EditingNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel><StackPanel Grid.Row="8" Grid.ColumnSpan="2"><TextBlock Text="Custom fields" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False" CanUserAddRows="True" MinHeight="100"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel></Grid></ScrollViewer></Border>
          </Grid>
        </TabItem>

        <TabItem Header="Characters"><Grid x:Name="CharactersHost" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Character" Click="AddCharacter_Click"/><Button Content="Delete" Click="DeleteCharacter_Click"/></StackPanel><ListBox ItemsSource="{Binding Project.Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name"/></DockPanel></Border><ContentControl Grid.Column="1" Content="{Binding SelectedCharacter}" ContentTemplate="{StaticResource EntityEditorTemplate}"/></Grid></TabItem>
        <TabItem Header="Places"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Place" Click="AddPlace_Click"/><Button Content="Delete" Click="DeletePlace_Click"/></StackPanel><ListBox ItemsSource="{Binding Project.Places}" SelectedItem="{Binding SelectedPlace}" DisplayMemberPath="Name"/></DockPanel></Border><ContentControl Grid.Column="1" Content="{Binding SelectedPlace}" ContentTemplate="{StaticResource EntityEditorTemplate}"/></Grid></TabItem>
        <TabItem Header="Notes"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Note" Click="AddNote_Click"/><Button Content="Delete" Click="DeleteNote_Click"/></StackPanel><ListBox ItemsSource="{Binding Project.Notes}" SelectedItem="{Binding SelectedNote}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><ContentControl Grid.Column="1" Content="{Binding SelectedNote}" ContentTemplate="{StaticResource EntityEditorTemplate}"/></Grid></TabItem>

        <TabItem Header="Relationships">
          <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="＋ Relationship" Click="AddRelationship_Click"/><Button Content="Delete" Click="DeleteRelationship_Click"/></StackPanel><ListBox x:Name="RelationshipList" ItemsSource="{Binding Project.Relationships}" SelectedItem="{Binding SelectedRelationship}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Type}" Margin="4"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel DataContext="{Binding SelectedRelationship}"><TextBlock Text="Character &amp; world connections" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="From" Margin="0,12,0,0"/><ComboBox x:Name="RelationFrom" SelectedValue="{Binding FromEntityId}" SelectedValuePath="Id" DisplayMemberPath="Name"/><TextBlock Text="Relationship"/><TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="To"/><ComboBox x:Name="RelationTo" SelectedValue="{Binding ToEntityId}" SelectedValuePath="Id" DisplayMemberPath="Name"/><TextBlock Text="Description"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="180" TextWrapping="Wrap"/></StackPanel></Border></Grid>
        </TabItem>

        <TabItem Header="Search">
          <Border Style="{StaticResource Card}" Margin="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Search the entire series bible" FontSize="20" FontWeight="SemiBold"/><DockPanel Margin="0,10,0,10"><Button DockPanel.Dock="Right" Content="Search" Click="Search_Click" IsDefault="True"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/></DockPanel></StackPanel><ListView ItemsSource="{Binding SearchResults}" MouseDoubleClick="SearchResult_DoubleClick"><ListView.View><GridView><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Kind}" Width="110"/><GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="240"/><GridViewColumn Header="Context" DisplayMemberBinding="{Binding Context}" Width="750"/></GridView></ListView.View></ListView></DockPanel></Border>
        </TabItem>
        <TabItem Header="Series View">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Project.Books}" Margin="12">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="300" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBlock Text="Story spine" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Chapters}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,7"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Section}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>

</Window>
